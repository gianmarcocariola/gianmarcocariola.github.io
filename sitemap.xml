<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.pages | sort: 'url' %}{% for entry in pages %}{% if entry.layout == 'default' and entry.url != '/404.html' and entry.sitemap != false %}
  <url><loc>{{ entry.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc></url>
{% endif %}{% endfor %}
</urlset>
